# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# Only the public (anon / publishable) Supabase key belongs here. Never put a secret key in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Address of the Python review service
VITE_REVIEW_API_URL=http://localhost:8000

# Shared password of the demo accounts (demo-only accounts, no real data)
VITE_DEMO_PASSWORD=Demo@12345
